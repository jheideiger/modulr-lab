# Cloudflare (Worker modulr-lab, fichiers statiques) : en-têtes HTTP (copié dans dist/ par scripts/build.mjs)
#
# La Content-Security-Policy est bloquante. Scripts : les fichiers du site, et les scripts en ligne
# désignés par leur empreinte sha256 (404.html, pages de redirection ; lang.js et intro-veil.js,
# mis en ligne par scripts/build.mjs qui ajoute leurs empreintes ici). Aucun gestionnaire
# d'événement dans le HTML (onclick, onerror…) : ils seraient refusés. Un script en ligne modifié
# doit voir son empreinte recalculée (la console donne la nouvelle). Styles : 'unsafe-inline'
# reste nécessaire tant que les pages ont des attributs style="" (phase 3).
#
# Cache : HTML, CSS et JS gardent le comportement par défaut de Cloudflare (revalidation
# à chaque visite). Les polices, three.js et les images changent de nom quand elles changent
# (three-r147.min.js), d'où le cache d'un an. Une miniature refaite (nouvelle vignette YouTube)
# doit changer de nom, par exemple <id>-v2-960.webp, sinon les visiteurs gardent l'ancienne un an.

/*
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-DamCoPgB/VkDCPsu0R6X4sJsz1c66vGlUGBXLu04Yxg=' 'sha256-ry51m2OGf9Uv3YTtYeQCAasckGxPvIrh5sUima4KvuI=' 'sha256-NBTvTMUNj5tozo+kyAjCLOAUbc50I6rHATwbwBvRsyU=' 'sha256-hn97lZp1Tjiyzn2PQFeJme7iL8RvpYbITCoIWMK2eHU=' 'sha256-XR2cN0jn3Tn9ilNQzWAOaFc4mCwVmEWqV26wAy2dVRg=' 'sha256-EtJJ4LI1u7uwyj5gHNKSXX4YDs1NWaoiBmN6VlbiNz8='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://assets.mailerlite.com https://formspree.io; frame-src https://www.youtube-nocookie.com https://www.youtube.com; form-action 'self' https://assets.mailerlite.com https://formspree.io; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/js/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/images/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=604800

/textures/*
  Cache-Control: public, max-age=604800
